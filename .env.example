# Reference only: export these values in your shell; .env is not auto-loaded.
# Generate a fresh DJANGO_SECRET_KEY; never use the test-settings key.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local synthetic-data development only. Unset for PostgreSQL.
BUDGET_LOCAL_SQLITE=1
PGDATABASE=budget
PGUSER=budget
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
# DEBUG uses console email. Production defaults to SMTP; configure before use.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=budget@localhost
